        "h": 0,
        "l": 0,
        "c": 0,
        "v": 0,
        "source": "provider name",
        "session": "overnight|premarket|regular|afterhours"
      }
    ]
  },
  "browser_api": [
    "window.MinuteLedger24H.getPayload()",
